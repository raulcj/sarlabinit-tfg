<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="640.0" prefWidth="860.0" styleClass="panel-ejs-raiz" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.nebsyst.sarlabinit.controller.PanelEJSAppListController">
   <children>
      <BorderPane styleClass="panel-ejs-contenedor" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <left>
            <VBox alignment="TOP_CENTER" prefWidth="196.0" spacing="18.0" styleClass="panel-ejs-marca" BorderPane.alignment="CENTER">
               <children>
                  <VBox alignment="CENTER" spacing="10.0" styleClass="panel-ejs-bloque-marca">
                     <children>
                        <ImageView fitHeight="85.0" fitWidth="160.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../resource/Enlarge_Banner.png" />
                           </image>
                        </ImageView>
                     </children>
                  </VBox>
                  <Label styleClass="panel-discovery-titulo-marca" text="SARLABINIT" />
                  <Label alignment="CENTER" styleClass="panel-discovery-subtitulo-marca" text="Gestor EJS" wrapText="true" /> 
                  <Region VBox.vgrow="ALWAYS" />
                  <ImageView fitHeight="37.0" fitWidth="124.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../resource/sarlab.png" />
                     </image>
                  </ImageView>
               </children>
               <padding>
                  <Insets bottom="20.0" left="18.0" right="18.0" top="24.0" />
               </padding>
            </VBox>
         </left>
         <center>
            <VBox spacing="16.0" styleClass="panel-ejs-contenido-principal" BorderPane.alignment="CENTER">
               <children>
                  <AnchorPane fx:id="jPanel1" minHeight="104.0" prefHeight="104.0" styleClass="panel-ejs-cabecera">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="16.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                           <children>
                             
                              <VBox alignment="CENTER_LEFT" spacing="5.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="panel-ejs-titulo-pagina" text="Gestión de servicios EJSApp" />
                                    <Label styleClass="panel-ejs-descripcion-pagina" text="Servicios &amp; Aplicaciones EJS disponibles" wrapText="true" />
                                 </children>
                              </VBox>
                              <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../resource/execjar64.png" />
                                 </image>
                              </ImageView>
                           </children>
                           <padding>
                              <Insets bottom="18.0" left="20.0" right="20.0" top="18.0" />
                           </padding>
                        </HBox>
                     </children>
                  </AnchorPane>
                  <VBox spacing="16.0" VBox.vgrow="ALWAYS">
                     <children>
                        <TitledPane fx:id="jPanel2" collapsible="false" maxWidth="Infinity" styleClass="panel-ejs-tarjeta" text="Servicios" VBox.vgrow="ALWAYS">
                           <content>
                              <BorderPane styleClass="panel-ejs-contenido-tarjeta">
                                 <top>
                                    <VBox spacing="8.0" styleClass="panel-ejs-resumen-lista" BorderPane.alignment="CENTER">
                                       <children>
                                          <HBox alignment="CENTER_LEFT" fillHeight="false" spacing="46.0" styleClass="panel-ejs-columnas-lista">
                                             <children>
                                                <Label alignment="CENTER" maxWidth="Infinity" minWidth="135.0" prefWidth="165.0" text="Aplicación jar" HBox.hgrow="ALWAYS" />
                                                <Label alignment="CENTER" maxWidth="Infinity" minWidth="135.0" prefWidth="165.0" text="Parámetros" HBox.hgrow="ALWAYS" />
                                                <Label alignment="CENTER" maxWidth="Infinity" minWidth="135.0" prefWidth="165.0" text="Descripción" HBox.hgrow="ALWAYS" />
                                             </children>
                                          </HBox>
                                       </children>
                                    </VBox>
                                 </top>
                                 <center>
                                    <ScrollPane fx:id="jScrollPane1" fitToHeight="true" fitToWidth="true" onInputMethodTextChanged="#jList1ValueChanged" styleClass="panel-ejs-scroll-lista" BorderPane.alignment="CENTER">
                                       <content>
                                          <ListView fx:id="jList1" onMouseClicked="#jList1MouseClicked" onMousePressed="#jList1MousePressed" />
                                       </content>
                                    </ScrollPane>
                                 </center>
                                 <bottom>
                                    <ToolBar styleClass="panel-ejs-barra-acciones panel-ejs-barra-herramientas" BorderPane.alignment="CENTER">
                                       <items>
                                          <HBox alignment="CENTER_LEFT" fillHeight="false" maxWidth="Infinity" spacing="14.0" styleClass="panel-ejs-fila-acciones">
                                             <children>
                                                <Button fx:id="jButtonEdit" mnemonicParsing="false" onAction="#jButtonEditActionPerformed" text="Editar" />
                                                <Button fx:id="jButtonErase" mnemonicParsing="false" onAction="#jButtonEraseActionPerformed" text="Borrar" />
                                                <Button fx:id="jButtonNew" mnemonicParsing="false" onAction="#jButtonNewActionPerformed" text="Nuevo" />
                                                <Button fx:id="jButton1" mnemonicParsing="false" onAction="#jButton1ActionPerformed" text="Ejecutar" />
                                                <Button fx:id="jButton3" mnemonicParsing="false" onAction="#jButton3ActionPerformed" text="Parar" />
                                                <Button fx:id="jButton4" mnemonicParsing="false" onAction="#jButton4ActionPerformed" text="ListPS" />
                                                <Button fx:id="jButton5" mnemonicParsing="false" onAction="#jButton5ActionPerformed" text="Subir" />
                                             </children>
                                          </HBox>
                                       </items>
                                    </ToolBar>
                                 </bottom>
                              </BorderPane>
                           </content>
                        </TitledPane>
                        <TitledPane fx:id="jPanel3" collapsible="false" maxWidth="Infinity" minHeight="170.0" prefHeight="185.0" styleClass="panel-ejs-tarjeta" text="Nueva aplicación EJS">
                           <content>
                              <VBox spacing="13.0" styleClass="panel-ejs-contenido-formulario">
                                 <children>
                                    <HBox alignment="BOTTOM_LEFT" spacing="14.0">
                                       <children>
                                          <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                             <children>
                                                <Label styleClass="panel-ejs-etiqueta-campo" text="Aplicación jar" />
                                                <HBox spacing="8.0">
                                                   <children>
                                                      <TextField fx:id="jTextFieldNameEJSApp" HBox.hgrow="ALWAYS" />
                                                      <Button fx:id="jButton2" mnemonicParsing="false" onAction="#jButton2ActionPerformed" text="Buscar" />
                                                   </children>
                                                </HBox>
                                             </children>
                                          </VBox>
                                          <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                             <children>
                                                <Label styleClass="panel-ejs-etiqueta-campo" text="Parámetros" />
                                                <TextField fx:id="jTextFieldParam" />
                                             </children>
                                          </VBox>
                                          <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                             <children>
                                                <Label styleClass="panel-ejs-etiqueta-campo" text="Descripción" />
                                                <TextField fx:id="jTextFieldDescrip" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="panel-ejs-acciones-formulario">
                                       <children>
                                          <Button fx:id="jButton7" mnemonicParsing="false" onAction="#jButton7ActionPerformed" text="Iniciar" />
                                          <Button fx:id="jButtonAñadirModificar" mnemonicParsing="false" onAction="#jButtonAñadirModificarActionPerformed" text="Añadir..." />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </content>
                        </TitledPane>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
